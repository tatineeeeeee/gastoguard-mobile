# Clerk — use the SAME Clerk app as the web project
# Copy the NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY value from gastoguard/.env.local
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Convex — use the SAME deployment URL as the web project
# Run `npx convex dashboard` in the web project to find the URL
EXPO_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
